digraph G { graph [rankdir=TB,bgcolor="transparent",pad="0.2",nodesep="0.35",ranksep="0.45"]; node [shape=box,style="rounded,filled",fillcolor="#eff5ff",color="#7890b0",fontname="sans-serif",fontsize=12,margin="0.18,0.12"]; edge [fontname="sans-serif",fontsize=11,color="#465b76",arrowsize=0.8];a [label=<<FONT POINT-SIZE="11">libclankerd/src/net/vmnet.rs</FONT><BR/><B>Network::start</B><BR/>Send Request::Create>];b [label=<<FONT POINT-SIZE="11">clankerd-network/src/daemon.rs</FONT><BR/><B>request(Create)</B><BR/>Create network connection>];c [label=<<FONT POINT-SIZE="11">clankerd-vmspawn/src/lib.rs</FONT><BR/><B>libclankerd::net::Attachment::open</B><BR/>Send Request::Attach>];d [label=<<FONT POINT-SIZE="11">clankerd-network/src/daemon.rs</FONT><BR/><B>request(Attach)</B><BR/>Associate connection with this machine process>,fillcolor="#e0f4e6"];e [label=<<FONT POINT-SIZE="11">clankerd-network/src/daemon.rs</FONT><BR/><B>run: five-second cleanup loop</B><BR/>After 120 seconds, mark connection inactive>,fillcolor="#fff2c5"];f [label=<<FONT POINT-SIZE="11">clankerd-network/src/daemon.rs</FONT><BR/><B>remove</B><BR/>Attempt worker and firewall cleanup>];g [label=<<FONT POINT-SIZE="11">clankerd-network/src/daemon.rs</FONT><BR/><B>request(Attach)</B><BR/>Late Attach rejected; machine cannot use expired connection>,fillcolor="#ffe5df"];a -> b [label=""];b -> c [label="machine reaches Attachment::open"];c -> d [label="accepted"];b -> e [label="machine never attaches"];e -> f [label=""];e -> g [label="machine attaches too late"];}