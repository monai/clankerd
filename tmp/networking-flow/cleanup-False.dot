digraph G { graph [rankdir=TB,bgcolor="transparent",pad="0.2",nodesep="0.35",ranksep="0.45"]; node [shape=box,style="rounded,filled",fillcolor="#eff5ff",color="#7890b0",fontname="sans-serif",fontsize=12,margin="0.18,0.12"]; edge [fontname="sans-serif",fontsize=11,color="#465b76",arrowsize=0.8];a [label=<<FONT POINT-SIZE="11">libclankerd/src/net/vmnet.rs</FONT><BR/><B>Network::stop</B><BR/>Send Request::Stop>];b [label=<<FONT POINT-SIZE="11">clankerd-network/src/daemon.rs</FONT><BR/><B>request → remove</B><BR/>Receive connection identifier>];c [label=<<FONT POINT-SIZE="11">clankerd-network/src/daemon.rs</FONT><BR/><B>remove</B><BR/>Stop network worker; delete connection record>];d [label=<<FONT POINT-SIZE="11">clankerd-network/src/pf.rs</FONT><BR/><B>apply(Change::Remove)</B><BR/>Remove firewall rules and save result>];e [label=<<B>Cleanup succeeded?</B><BR/>>,fillcolor="#fff2c5",shape=diamond];f [label=<<FONT POINT-SIZE="11">clankerd-network/src/daemon.rs</FONT><BR/><B>remove</B><BR/>Return success>,fillcolor="#e0f4e6"];g [label=<<FONT POINT-SIZE="11">libclankerd/src/net/vmnet.rs</FONT><BR/><B>Network::stop</B><BR/>Delete net-lease.json>,fillcolor="#e0f4e6"];h [label=<<FONT POINT-SIZE="11">clankerd-network/src/daemon.rs</FONT><BR/><B>remove</B><BR/>Record already gone; return error>,fillcolor="#ffe5df"];i [label=<<FONT POINT-SIZE="11">libclankerd/src/net/vmnet.rs</FONT><BR/><B>Network::stop</B><BR/>Delete net-lease.json despite failure>,fillcolor="#ffe5df"];j [label=<<FONT POINT-SIZE="11">clankerd-network/src/daemon.rs</FONT><BR/><B>request → remove</B><BR/>Later Stop finds no record; reports success>,fillcolor="#ffe5df"];a -> b [label="request"];b -> c [label=""];c -> d [label=""];d -> e [label=""];e -> f [label="yes"];f -> g [label="reply"];e -> h [label="no"];h -> i [label="error reply"];i -> j [label="another Stop"];}