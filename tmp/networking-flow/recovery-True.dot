digraph G { graph [rankdir=TB,bgcolor="transparent",pad="0.2",nodesep="0.35",ranksep="0.45"]; node [shape=box,style="rounded,filled",fillcolor="#eff5ff",color="#7890b0",fontname="sans-serif",fontsize=12,margin="0.18,0.12"]; edge [fontname="sans-serif",fontsize=11,color="#465b76",arrowsize=0.8];a [label=<<FONT POINT-SIZE="11">clankerd-network/src/pf.rs</FONT><BR/><B>apply(Change::Register)</B><BR/>Need to enable firewall filtering>];b [label=<<FONT POINT-SIZE="11">clankerd-network/src/pf.rs</FONT><BR/><B>command(pfctl -E)</B><BR/>Ask macOS to enable filtering; receive release number>];c [label=<<FONT POINT-SIZE="11">clankerd-network/src/pf.rs</FONT><BR/><B>persist</B><BR/>Save release number in state.json>,fillcolor="#e0f4e6"];x [label=<<B>Program crashes before number is saved</B><BR/>macOS request can remain; saved release number is missing>,fillcolor="#ffe5df"];p [label=<<FONT POINT-SIZE="11">clankerd-network/src/pf.rs</FONT><BR/><B>persist</B><BR/>Save acquiring=true in state.json>];q [label=<<FONT POINT-SIZE="11">clankerd-network/src/pf.rs</FONT><BR/><B>command</B><BR/>Command cannot start; acquiring=true remains>,fillcolor="#ffe5df"];r [label=<<FONT POINT-SIZE="11">clankerd-network/src/pf.rs</FONT><BR/><B>reset → recover</B><BR/>Read acquiring=true; refuse program startup>,fillcolor="#ffe5df"];a -> p [label=""];p -> b [label="command starts"];p -> q [label="command fails to start"];b -> c [label="number saved successfully"];b -> x [label="crash before save"];q -> r [label="restart"];x -> r [label="restart"];}