if(EXISTS "${OUTPUT}")
    file(SHA256 "${OUTPUT}" actual)
    if(actual STREQUAL SHA256)
        return()
    endif()
    message(FATAL_ERROR "Cached input failed SHA256 verification: ${OUTPUT}")
endif()
get_filename_component(directory "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${directory}")
string(RANDOM LENGTH 16 suffix)
set(temporary "${OUTPUT}.${suffix}.tmp")
file(DOWNLOAD "${URL}" "${temporary}" STATUS status TLS_VERIFY ON)
list(GET status 0 code)
if(NOT code EQUAL 0)
    file(REMOVE "${temporary}")
    message(FATAL_ERROR "Input download failed: ${status}")
endif()
file(SHA256 "${temporary}" actual)
if(NOT actual STREQUAL SHA256)
    file(REMOVE "${temporary}")
    message(FATAL_ERROR "Downloaded input failed SHA256 verification: ${URL}")
endif()
file(RENAME "${temporary}" "${OUTPUT}")
