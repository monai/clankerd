set(CLANKERD_HOST_ENV)
if(DEFINED ENV{HOST_RUSTFLAGS})
    set(CLANKERD_HOST_RUSTFLAGS "$ENV{HOST_RUSTFLAGS}")
elseif(DEFINED ENV{CARGO_ENCODED_RUSTFLAGS})
    set(CLANKERD_HOST_RUSTFLAGS "$ENV{CARGO_ENCODED_RUSTFLAGS}")
elseif(DEFINED ENV{RUSTFLAGS})
    string(REGEX REPLACE "[ \t]+" ";" flags "$ENV{RUSTFLAGS}")
elseif(DEFINED ENV{CARGO_TARGET_AARCH64_APPLE_DARWIN_RUSTFLAGS})
    string(REGEX REPLACE "[ \t]+" ";" flags "$ENV{CARGO_TARGET_AARCH64_APPLE_DARWIN_RUSTFLAGS}")
endif()
string(ASCII 31 separator)
if(DEFINED flags)
    list(JOIN flags "${separator}" CLANKERD_HOST_RUSTFLAGS)
endif()
if(CLANKERD_HOMEBREW)
    if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin" OR NOT CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "^(arm64|aarch64)$")
        message(FATAL_ERROR "Homebrew configuration requires native Apple Silicon macOS")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E environment OUTPUT_VARIABLE environment)
    string(REPLACE "\n" ";" environment "${environment}")
    foreach(entry IN LISTS environment)
        if(entry MATCHES "^(DYLD_[^=]+)=")
            list(APPEND CLANKERD_HOST_ENV "--unset=${CMAKE_MATCH_1}")
        endif()
    endforeach()
    find_program(brew brew REQUIRED)
    execute_process(COMMAND "${brew}" deps --installed --formula libkrun OUTPUT_VARIABLE dependencies COMMAND_ERROR_IS_FATAL ANY OUTPUT_STRIP_TRAILING_WHITESPACE)
    string(REPLACE "\n" ";" dependencies "${dependencies}")
    set(formulas libkrun libkrunfw xz ${dependencies})
    list(REMOVE_DUPLICATES formulas)
    set(libraries)
    foreach(formula IN LISTS formulas)
        execute_process(COMMAND "${brew}" --prefix "${formula}" OUTPUT_VARIABLE prefix COMMAND_ERROR_IS_FATAL ANY OUTPUT_STRIP_TRAILING_WHITESPACE)
        list(APPEND libraries "${prefix}/lib")
    endforeach()
    list(REMOVE_DUPLICATES libraries)
    foreach(library IN LISTS libraries)
        set(CLANKERD_HOST_RUSTFLAGS "${CLANKERD_HOST_RUSTFLAGS}${separator}-Lnative=${library}${separator}-Clink-arg=-Xlinker${separator}-Clink-arg=-rpath${separator}-Clink-arg=-Xlinker${separator}-Clink-arg=${library}")
    endforeach()
    string(REGEX REPLACE "^${separator}" "" CLANKERD_HOST_RUSTFLAGS "${CLANKERD_HOST_RUSTFLAGS}")
endif()
if(DEFINED CLANKERD_HOST_RUSTFLAGS)
    list(APPEND CLANKERD_HOST_ENV "CARGO_ENCODED_RUSTFLAGS=${CLANKERD_HOST_RUSTFLAGS}")
endif()
