include(FetchContent)
set(Rust_CARGO_TARGET aarch64-unknown-linux-musl)
set(Rust_CARGO "${CLANKERD_CARGO_EXECUTABLE}")
FetchContent_Declare(Corrosion GIT_REPOSITORY https://github.com/corrosion-rs/corrosion.git GIT_TAG a1a1aaa057a5da656c06c3d8505b767a4e941709 GIT_SHALLOW FALSE)
FetchContent_MakeAvailable(Corrosion)
corrosion_import_crate(MANIFEST_PATH "${CLANKERD_SOURCE_DIR}/Cargo.toml" CRATES clankerd-guestd PROFILE release LOCKED NO_LINKER_OVERRIDE)
corrosion_set_linker(clankerd-guestd rust-lld)
set(CLANKERD_GUEST_BINARY "$<TARGET_FILE:clankerd-guestd>")
add_custom_target(cargo-guest DEPENDS cargo-build_clankerd-guestd)
if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin" AND CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "^(arm64|aarch64)$")
    corrosion_import_crate(MANIFEST_PATH "${CLANKERD_SOURCE_DIR}/Cargo.toml" CRATES vmctl clankerd-vmspawn clankerd-network PROFILE release LOCKED NO_LINKER_OVERRIDE)
    foreach(program vmctl clankerd-vmspawn clankerd-network)
        corrosion_set_hostbuild(${program})
        if(CLANKERD_HOST_ENV)
            corrosion_set_env_vars(${program} ${CLANKERD_HOST_ENV})
        endif()
    endforeach()
    set(CLANKERD_HOST_BINARY_DIR "${CMAKE_BINARY_DIR}")
    add_custom_target(cargo-host DEPENDS cargo-build_vmctl cargo-build_clankerd-vmspawn cargo-build_clankerd-network)
else()
    set(CLANKERD_HOST_BINARY_DIR "${CMAKE_BINARY_DIR}")
    add_custom_target(cargo-host COMMAND "${CMAKE_COMMAND}" -E echo "Host executables require native Apple Silicon macOS" COMMAND "${CMAKE_COMMAND}" -E false)
endif()
