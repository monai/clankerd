foreach(program vmctl clankerd-vmspawn clankerd-network)
    set(path "${CLANKERD_ARTIFACT_DIR}/darwin-arm64/${program}")
    if(NOT EXISTS "${path}")
        message(FATAL_ERROR "Missing host executable: ${path}")
    endif()
    file(READ "${path}" header LIMIT 8 HEX)
    if(NOT header STREQUAL "cffaedfe0c000001")
        message(FATAL_ERROR "Host executable is not arm64 Mach-O: ${path}")
    endif()
endforeach()
message(STATUS "PASS arm64 host executables")
