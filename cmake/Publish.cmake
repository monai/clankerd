include("${CONFIG}")
include("${CLANKERD_INPUTS}")
set(stage "${CLANKERD_WORK_DIR}/artifact")
if(IS_SYMLINK "${stage}")
    message(FATAL_ERROR "Artifact staging must be an ordinary directory")
endif()
file(REMOVE_RECURSE "${stage}/licenses")
file(MAKE_DIRECTORY "${stage}/darwin-arm64" "${stage}/licenses/texts" "${stage}/licenses/guest" "${CLANKERD_WORK_DIR}/signed-inputs")
foreach(program vmctl clankerd-vmspawn clankerd-network)
    set(source "${CLANKERD_HOST_BINARY_DIR}/${program}")
    file(SHA256 "${source}" source_hash)
    set(entitlements)
    if(program STREQUAL "clankerd-vmspawn")
        set(entitlement "${CLANKERD_SOURCE_DIR}/crates/clankerd-vmspawn/entitlements.plist")
        file(SHA256 "${entitlement}" entitlement_hash)
        string(APPEND source_hash "${entitlement_hash}")
        set(entitlements -e "${entitlement}")
    endif()
    set(output "${stage}/darwin-arm64/${program}")
    set(previous "")
    set(source_stamp "${CLANKERD_WORK_DIR}/signed-inputs/${program}")
    if(EXISTS "${source_stamp}")
        file(READ "${source_stamp}" previous)
    endif()
    if(NOT source_hash STREQUAL previous OR NOT EXISTS "${output}")
        file(COPY_FILE "${source}" "${output}.tmp")
        file(CHMOD "${output}.tmp" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
        execute_process(COMMAND "${CLANKERD_SIGNER}" sign --binary-identifier "io.clankerd.${program}" ${entitlements} "${output}.tmp" RESULT_VARIABLE status)
        if(NOT status EQUAL 0)
            file(REMOVE "${output}.tmp")
            message(FATAL_ERROR "Signing failed for ${program}")
        endif()
        file(RENAME "${output}.tmp" "${output}")
        file(WRITE "${source_stamp}" "${source_hash}")
    endif()
endforeach()
set(management "${stage}/linux-arm64/management")
file(REMOVE_RECURSE "${management}")
file(MAKE_DIRECTORY "${management}")
file(COPY "${CLANKERD_MANAGEMENT_DIR}/" DESTINATION "${management}" USE_SOURCE_PERMISSIONS PATTERN .stamp EXCLUDE)
file(COPY_FILE "${CLANKERD_GUEST_BINARY}" "${management}/usr/sbin/clankerd-guestd" ONLY_IF_DIFFERENT)
file(CHMOD "${management}/usr/sbin/clankerd-guestd" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
file(COPY_FILE "${CLANKERD_INPUTS}" "${stage}/inputs.cmake" ONLY_IF_DIFFERENT)
foreach(input IN LISTS LICENSE_INPUTS)
    file(COPY_FILE "${${input}_ARCHIVE}" "${stage}/licenses/texts/${input}.txt" ONLY_IF_DIFFERENT)
endforeach()
foreach(input IN LISTS INPUTS)
    if(EXISTS "${CLANKERD_WORK_DIR}/packages/${input}/package-metadata")
        file(MAKE_DIRECTORY "${stage}/licenses/guest/${input}")
        file(COPY "${CLANKERD_WORK_DIR}/packages/${input}/package-metadata/" DESTINATION "${stage}/licenses/guest/${input}" USE_SOURCE_PERMISSIONS)
    endif()
endforeach()
file(COPY_FILE "${management}/lib/apk/db/installed" "${stage}/licenses/alpine-base-installed" ONLY_IF_DIFFERENT)
set(CLANKERD_ARTIFACT_DIR_SAVED "${CLANKERD_ARTIFACT_DIR}")
set(CLANKERD_ARTIFACT_DIR "${stage}")
include("${CLANKERD_SOURCE_DIR}/cmake/VerifyHost.cmake")
set(CLANKERD_ARTIFACT_DIR "${CLANKERD_ARTIFACT_DIR_SAVED}")
execute_process(COMMAND bash "${CLANKERD_SOURCE_DIR}/scripts/build/publish.sh" "${stage}" "${CLANKERD_ARTIFACT_DIR}" "${Python3_EXECUTABLE}" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Artifact publication failed")
endif()
