  - targets:         [ arm64-macos ]
    symbols:         [ _SecCopyErrorMessageString, _SecCertificateCopySubjectSummary, _SecCertificateCreateWithData,
                       _SecPolicyCreateSSL, _SecTrustCreateWithCertificates,
                       _SecTrustEvaluateWithError, _SecTrustSetAnchorCertificates,
                       _SecTrustSetAnchorCertificatesOnly, _SecTrustSetOCSPResponse,
                       _SecTrustSetVerifyDate ]
...
